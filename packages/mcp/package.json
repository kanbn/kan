{
  "name": "@kan.bn/mcp",
  "version": "0.1.0",
  "description": "MCP server for Kan — control workspaces, boards, lists, and cards via AI",
  "type": "module",
  "bin": {
    "kan-mcp": "./bin/kan-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit false --declaration false --emitDeclarationOnly false --outDir dist",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --noEmit false --declaration false --emitDeclarationOnly false --outDir dist",
    "dev:watch": "tsc --noEmit false --declaration false --emitDeclarationOnly false --outDir dist --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kan/tsconfig": "workspace:*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  }
}
