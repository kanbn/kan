    "schemas": {
      "BoardMemberDto": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          },
          "workspaceRole": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "nullable": true
              },
              "name": {
                "type": "string",
                "nullable": true
              },
              "email": {
                "type": "string"
              },
              "image": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "image"
            ],
            "nullable": true
          }
        },
        "required": [
          "publicId",
          "email",
          "status",
          "role",
          "workspaceRole",
          "createdAt",
          "user"
        ]
      },
      "AddBoardMemberDto": {
        "type": "object",
        "properties": {
          "workspaceMemberPublicId": {
            "type": "string",
            "minLength": 12
          },
          "role": {
            "default": "member",
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        },
        "required": [
          "workspaceMemberPublicId"
        ]
      },
      "BoardMemberRoleResultDto": {
        "type": "object",
