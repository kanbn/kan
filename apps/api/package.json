{
  "name": "@kan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "pnpm with-env node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "pnpm with-env node --import @swc-node/register/esm-register src/main.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "openapi": "node --import @swc-node/register/esm-register src/openapi.generate.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kan/auth": "workspace:*",
    "@kan/db": "workspace:*",
    "@kan/logger": "workspace:^",
    "@kan/server": "workspace:*",
    "@kan/shared": "workspace:^",
    "@kan/stripe": "workspace:^",
    "@kan/tsconfig": "workspace:*",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/microservices": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@rekog/mcp-nest": "^2.0.10",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "nestjs-zod": "^5.5.0",
    "rate-limiter-flexible": "^11.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kan/eslint-config": "workspace:*",
    "@kan/prettier-config": "workspace:*",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "dotenv-cli": "^11.1.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.0.0"
  },
  "prettier": "@kan/prettier-config"
}
