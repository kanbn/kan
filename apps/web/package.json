    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^7.0.6",
    "@kan.bn/mcp": "workspace:*",
    "@kan/api-client": "workspace:*",
    "@kan/auth": "workspace:*",
    "@kan/db": "workspace:^",
    "@kan/email": "workspace:^",
    "@kan/logger": "workspace:^",
    "@kan/server": "workspace:*",
    "@kan/shared": "workspace:^",
    "@lingui/conf": "^5.3.2",
    "@lingui/macro": "^5.3.2",
    "@lingui/react": "^5.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "catalog:",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-typography": "^3.34.0",
