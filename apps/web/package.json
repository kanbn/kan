    "@types/node": "^24.19.2",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv-cli": "^11.1.0",
    "eslint": "catalog:",
    "jiti": "^2.7.0",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  },
  "prettier": "@kan/prettier-config"
}
