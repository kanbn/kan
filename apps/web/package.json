    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "next-runtime-env": "^1.7.2",
    "next-themes": "^0.4.6",
    "nextjs-cors": "^2.2.1",
    "posthog-js": "^1.448.0",
    "react": "catalog:react19",
    "react-contenteditable": "^3.3.7",
    "react-dom": "catalog:react19",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "react-image-crop": "^11.1.2",
    "react-lottie-player": "^2.1.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^2.5.2",
