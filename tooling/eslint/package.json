{
  "name": "@kan/eslint-config",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./nextjs": "./nextjs.js",
    "./react": "./react.js"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "~2.5.6",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "@kan/prettier-config": "workspace:*",
    "@kan/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "~2.5.6",
    "typescript": "catalog:"
  },
  "prettier": "@kan/prettier-config"
